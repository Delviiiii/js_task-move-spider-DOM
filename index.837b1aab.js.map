"use strict";
var spider = document.querySelector("img.spider");
var centerOfSpiderTop = spider.offsetHeight / 2;
var centerOfSpiderLeft = spider.offsetWidth / 2;
document.querySelector("body div.wall").addEventListener("click", function(e) {
    var wall = e.currentTarget;
    var startX = wall.offsetLeft + wall.clientLeft;
    var endX = wall.offsetLeft + wall.clientLeft + wall.clientWidth;
    var rangeX = [
        startX,
        endX
    ];
    var startY = wall.offsetTop + wall.clientTop;
    var endY = wall.offsetTop + wall.clientTop + wall.clientHeight;
    var rangeY = [
        startY,
        endY
    ];
    var coordOfClickX = function() {
        return e.clientX - centerOfSpiderLeft - rangeX[0] + "px";
    };
    var coordOfClickY = function() {
        return e.clientY - centerOfSpiderTop - rangeY[0] + "px";
    };
    // Moving spider
    if (coordOfClickX() <= rangeX[0]) spider.style.left = rangeX[0];
    else spider.style.left = coordOfClickX();
    if (coordOfClickY() <= rangeY[0]) spider.style.top = rangeY[0];
    else spider.style.top = coordOfClickY();
});

