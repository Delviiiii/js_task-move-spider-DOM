"use strict";
document.querySelector("body div.wall").addEventListener("click", function(e) {
    var spider = document.querySelector("img.spider");
    var centerOfSpider = spider.offsetHeight / 2;
    var wall = e.currentTarget;
    var startX = wall.offsetLeft + wall.clientLeft;
    var endX = wall.offsetLeft + wall.clientLeft + wall.clientWidth;
    var startY = wall.offsetTop + wall.clientTop;
    var endY = wall.offsetTop + wall.clientTop + wall.clientHeight;
    var localClickCoordX = function() {
        return e.clientX + window.scrollX - centerOfSpider - startX;
    };
    var localClickCoordY = function() {
        return e.clientY + window.scrollY - centerOfSpider - startY;
    };
    var coordToCSSValue = function(coord) {
        return coord + "px";
    };
    // Moving spider
    // By X coordinate
    if (localClickCoordX() + startX < startX) spider.style.left = coordToCSSValue(0);
    else if (localClickCoordX() + startX > endX - spider.offsetHeight) spider.style.left = coordToCSSValue(wall.clientWidth - spider.offsetWidth);
    else spider.style.left = coordToCSSValue(localClickCoordX());
    // By Y coordinate
    if (localClickCoordY() + startY < startY) spider.style.top = coordToCSSValue(0);
    else if (localClickCoordY() + startY > endY - spider.offsetHeight) spider.style.top = coordToCSSValue(wall.clientHeight - spider.offsetHeight);
    else spider.style.top = coordToCSSValue(localClickCoordY());
});

